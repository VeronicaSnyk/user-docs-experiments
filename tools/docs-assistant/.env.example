# Copy to .env.local for the browser UI, or set these as GitHub Actions secrets for the pipeline.
# NEVER commit real values. Names only here.

# Gemini (Google GenAI) API key — used by both the UI and the headless pipeline.
GEMINI_API_KEY=

# GitBook API token — used by the headless pipeline to create Change Requests.
# (The browser UI prompts for this at runtime; do not hardcode it.)
GITBOOK_API_TOKEN=

# GitBook space to draft into. See tools/docs-assistant/README.md for known space IDs.
GITBOOK_SPACE_ID=

# Slack bot token (chat:write) — pipeline posts the draft URL back to Slack.
SLACK_BOT_TOKEN=

# Jira — pipeline appends the draft URL as a comment on the ship-it-created ticket.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
